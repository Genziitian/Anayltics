{
  "name": "gi-tracker",
  "version": "0.1.0",
  "private": true,
  "description": "GI Tracker: revenue-first, self-hosted web analytics with Razorpay attribution. Node + Postgres.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch --env-file-if-exists=.env src/server/main.ts",
    "dev:web": "vite",
    "build": "vite build && npm run build:tracker && npm run build:server",
    "build:tracker": "esbuild public/js/gi.js --minify --legal-comments=inline --outfile=dist/js/gi.js --allow-overwrite",
    "build:server": "esbuild src/server/main.ts --bundle --platform=node --format=esm --target=node20 --packages=external --outfile=build/server.js",
    "start": "node build/server.js",
    "migrate": "tsx --env-file-if-exists=.env src/server/migrate-cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "seed": "node --env-file-if-exists=.env scripts/seed-demo.mjs",
    "smoke": "node --env-file-if-exists=.env scripts/smoke.mjs",
    "geoip:download": "node scripts/download-geoip.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "hono": "^4.13.13",
    "maxmind": "^5.0.7",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.1",
    "concurrently": "^10.0.6",
    "esbuild": "^0.28.2",
    "maplibre-gl": "^5.24.1",
    "postcss": "^8.5.31",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.4",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^6.4.5",
    "vitest": "^3.2.7"
  }
}
