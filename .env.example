# Copy to .env and fill in. Used by `npm run dev` locally and by docker compose on the server.

# Public hostname of your GI Tracker (Caddy gets an HTTPS certificate for it automatically).
DOMAIN=analytics.example.com

# Dashboard login (email + password) and cookie-signing secret. Generate a secret with: openssl rand -hex 32
# Changing the email or password signs out every device.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me
SESSION_SECRET=

# Postgres. docker compose creates the database with this password.
POSTGRES_PASSWORD=
# Only needed outside docker compose (compose builds it from POSTGRES_PASSWORD):
DATABASE_URL=postgres://localhost:5432/gitracker_dev

PORT=8787

# Header with the real visitor IP. Keep x-forwarded-for behind Caddy; use cf-connecting-ip if you put Cloudflare in front.
CLIENT_IP_HEADER=x-forwarded-for

# Visitor locations: path to a City .mmdb (downloaded automatically in docker; locally run `npm run geoip:download`).
GEOIP_DB=data/geoip.mmdb

# Re-read the last 48h of Razorpay payments this often (needs API keys in site settings). 0 disables.
RAZORPAY_SYNC_MINUTES=60

# Tracking events from browsers you use the dashboard from aren't counted (your own testing). Set false to count them.
EXCLUDE_OWNER_VISITS=true
